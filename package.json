{
  "name": "termix-vscode",
  "version": "1.1.0",
  "description": "Integrated Remote VS Code session launcher for Termix SSH",
  "type": "module",
  "main": "dist/backend/index.js",
  "browser": "dist/frontend/index.js",
  "scripts": {
    "build": "termix-plugin build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "validate": "termix-plugin validate",
    "test": "termix-plugin test",
    "pack": "termix-plugin pack",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "notice": "node scripts/generate-notice.mjs",
    "notice:check": "node scripts/generate-notice.mjs --check"
  },
  "dependencies": {
    "http-proxy": "^1.18.1",
    "lucide-react": "^1.61.0"
  },
  "devDependencies": {
    "@termix-ssh/plugin-sdk": "^1.0.20",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/express": "^4.17.25",
    "@types/http-proxy": "^1.17.14",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ssh2": "^1.11.19",
    "@types/ws": "^8.18.2",
    "express": "^4.22.3",
    "i18next": "^26.5.11",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "puppeteer-core": "^25.16.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.9",
    "sonner": "^2.0.8",
    "ssh2": "^1.15.0",
    "typescript": "^5.3.3",
    "vitest": "^5.0.5",
    "ws": "^8.22.0"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tech-Innovators-Dev/termix-vscode.git"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
